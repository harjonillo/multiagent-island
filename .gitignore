__pycache__/
*.egg-info/
.pytest_cache/
.env
.cache/
# Runs stay local, except the two files the explorer site is built from: commit a run's
# manifest.json and events.jsonl to publish it (README, "Publishing the explorer").
runs/*
!runs/*/
runs/*/*
!runs/*/manifest.json
!runs/*/events.jsonl
!runs/*/prompts/
_site/
